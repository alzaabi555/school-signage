rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{docId=**} {
      allow read, write: if true;
    }

    // Substitutions (الاحتياط اليومي)
    match /substitutions/{docId=**} {
      allow read, write: if true;
    }

    // Duties (المناوبة والإشراف)
    match /duties/{docId=**} {
      allow read, write: if true;
    }

    // Announcements (شريط الإعلانات)
    match /announcements/{docId=**} {
      allow read, write: if true;
    }

    // Timetable (جدول الحصص المدرسي)
    match /timetable/{docId=**} {
      allow read, write: if true;
    }

    // Periods (أوقات ومواقيت الحصص)
    match /periods/{docId=**} {
      allow read, write: if true;
    }

    // Settings (إعدادات الشاشات والنظام)
    match /settings/{docId=**} {
      allow read, write: if true;
    }

    // Allow read/write to all documents for kiosk signage and authenticated staff
    match /{collection}/{docId=**} {
      allow read, write: if true;
    }
  }
}
